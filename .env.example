# Configuración del Proyecto Foro-COAR
# Las sesiones se guardan en la colección "sessions" de esta misma base (connect-mongo).
MONGODB_URI=mongodb://localhost:27017/coar
SESSION_SECRET=genera_una_clave_segura_de_al_menos_32_caracteres

# Acceso restringido (solo correos institucionales @cusco.coar.edu.pe)
ALLOWED_EMAIL_DOMAINS=cusco.coar.edu.pe
ALLOWED_EMAILS=

# Opcional: un correo que siempre puede entrar (útil para el primer admin)
BOOTSTRAP_ADMIN_EMAIL=admin@cusco.coar.edu.pe

# Cookie de sesión (express-session + connect-mongo guarda el id en cookie)
# SESSION_COOKIE_NAME=coar.sid
# SESSION_MAX_AGE_DAYS=7
# SESSION_SAME_SITE=lax
# Si usas front y API en subdominios distintos: COOKIE_DOMAIN=.tudominio.com y SESSION_SAME_SITE=none + HTTPS
# COOKIE_DOMAIN=
# SESSION_COOKIE_SECURE=true

# URL pública del sitio
PUBLIC_URL=http://localhost:3000

# Orígenes permitidos para CORS (coma separada). Vacío = reflejar origen de la petición
# CORS_ORIGINS=https://tu-app.onrender.com

NODE_ENV=development

# Logs (winston): error | warn | info | debug
# LOG_LEVEL=info

# Cloudinary (opcional) — para subir imágenes
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=foro-coar

# Email para verificación (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
