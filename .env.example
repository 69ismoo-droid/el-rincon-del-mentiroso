# Copia a .env y rellena (no subas .env al repositorio).
# Las sesiones se guardan en la colección "sessions" de esta misma base (connect-mongo).
MONGODB_URI=mongodb://localhost:27017/coar
SESSION_SECRET=genera-un-string-aleatorio-de-al-menos-32-caracteres

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública del sitio (OAuth callback). En Render suele bastar RENDER_EXTERNAL_URL.
PUBLIC_URL=http://localhost:3000

# Orígenes permitidos para CORS (coma separada). Vacío = reflejar origen de la petición.
# CORS_ORIGINS=https://tu-app.onrender.com

NODE_ENV=development
